# ---- Server ----
PORT=8000
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# ---- Redis ----
# Local Redis:
REDIS_URL=redis://127.0.0.1:6379
# For Redis Cloud / Upstash, replace with your provider URL.

# ---- Auth ----
ACCESS_TOKEN_SECRET=change_me_to_a_long_random_string
ACCESS_TOKEN_EXPIRY=8h
# Staff accounts sign in with an EPIC number + OTP (no passwords).
# Format: three letters followed by seven digits.
ADMIN_EPIC=ADM1234567
BLO_EPIC=BLO1234567
ECI_EPIC=ECI1234567
VOTER_EPIC=ABC1234567

# ---- Persona ----
PERSONA_API_KEY=persona_sandbox_YOUR_KEY
PERSONA_TEMPLATE_ID=itmpl_YOUR_TEMPLATE_ID
PERSONA_ENVIRONMENT_ID=env_YOUR_SANDBOX_ENVIRONMENT_ID

# ---- Google Gemini AI ----
# Used for automated document sanity checking and generating AI reviews for BLOs
GEMINI_API=your_gemini_api_key_here

# ---- Python face service ----
FACE_REFERENCE_DIR=../face-service/reference
FACE_SERVICE_URL=http://localhost:5000
# Demo registration can enrol a reference face. Keep 0 outside a controlled prototype.
ALLOW_ENROLL=1

