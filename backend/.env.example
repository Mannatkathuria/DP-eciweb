# ---- Server ----
PORT=8000
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# ---- Redis ----
# Local Redis:
REDIS_URL=redis://127.0.0.1:6379
# For Redis Cloud / Upstash, replace with your provider URL.

# ---- MongoDB (optional) ----
# Read models copied from Redis: polling-station geo search, full event history, audit archive
# with its hash chain. Leave empty to run on Redis alone (features fall back to slower queries).
# Rebuild from Redis at any time with: npm run mongo:sync
MONGODB_URI=
# MONGODB_DB=eciweb

# ---- Auth ----
ACCESS_TOKEN_SECRET=change_me_to_a_long_random_string
ACCESS_TOKEN_EXPIRY=8h
# Staff accounts sign in with an EPIC number + OTP (no passwords).
# Format: three letters followed by seven digits.
ADMIN_EPIC=ADM1234567
BLO_EPIC=BLO1234567
ECI_EPIC=ECI1234567
VOTER_EPIC=ABC1234567

# ---- Aadhaar ----
# 64 hex characters (32 bytes). When set, a submitted Aadhaar number is stored encrypted (AES-256-GCM).
# When empty, only its last 4 digits are kept. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep it secret and never change it once applications are stored, or stored numbers can't be decrypted.
AADHAAR_ENCRYPTION_KEY=

# ---- Persona ----
PERSONA_API_KEY=persona_sandbox_YOUR_KEY
PERSONA_TEMPLATE_ID=itmpl_YOUR_TEMPLATE_ID
PERSONA_ENVIRONMENT_ID=env_YOUR_SANDBOX_ENVIRONMENT_ID
# Signing secret of the Persona webhook. Webhooks are refused until this is set.
PERSONA_WEBHOOK_SECRET=wbhsec_YOUR_WEBHOOK_SECRET
# The ECI polling-station identity step is not connected to Persona yet. Set to true only for a
# demonstration: the step then passes and every result is labelled "simulated".
PERSONA_DEMO_MODE=true

# ---- Google Gemini AI ----
# Used for automated document sanity checking and generating AI reviews for BLOs
GEMINI_API=your_gemini_api_key_here

# ---- Python face service ----
FACE_REFERENCE_DIR=../face-service/reference
FACE_SERVICE_URL=http://localhost:5000
# Demo registration can enrol a reference face. Keep 0 outside a controlled prototype.
ALLOW_ENROLL=1


# ---- Re-authentication (step-up) ----
# Approvals and other sensitive actions need a fresh one-time code. Keep "true" in production
# (the server refuses to start in production with it off, unless APP_MODE=training).
STEP_UP_REQUIRED=true
STEP_UP_MINUTES=10

# ---- Deployment mode ----
# "training" labels every response and allows only synthetic or mock data sources.
APP_MODE=live

# ---- Live updates and polling-station devices ----
# Socket.IO runs only on a long-running server (not on Vercel serverless). Set "off" to disable.
REALTIME=on
# Ed25519 private key (PKCS#8 PEM, or its base64) that signs offline station packages.
# Required in production. Generate with:
#   node -e "console.log(require('crypto').generateKeyPairSync('ed25519').privateKey.export({type:'pkcs8',format:'pem'}))"
# In development a key is generated and kept in Redis when this is empty.
PACKAGE_SIGNING_KEY=

# ---- Poll day and counting ----
# Time the poll opens (IST), used for control-room alerts.
POLL_START_IST=07:00
# Counting agents a candidate may appoint in one constituency.
MAX_COUNTING_AGENTS=15

# ---- Electoral roll ----
# Days the elector objected to (Form 7) has to reply before the ERO may accept the objection.
FORM7_NOTICE_DAYS=7

# ---- Legacy ----
# The old identity-document and face-match endpoints (need the Python face service). Off by default.
LEGACY_FACE_VERIFICATION=off
