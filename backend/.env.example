# ---- Server ----
PORT=8000
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# ---- Redis ----
# Local Redis:
REDIS_URL=redis://127.0.0.1:6379
# For Redis Cloud / Upstash, replace with your provider URL.

# ---- Auth ----
ACCESS_TOKEN_SECRET=change_me_to_a_long_random_string
ACCESS_TOKEN_EXPIRY=8h
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe@123
BLO_USERNAME=blo
BLO_PASSWORD=ChangeMe@123
ECI_USERNAME=eci
ECI_PASSWORD=ChangeMe@123

# ---- Python face service ----
FACE_REFERENCE_DIR=../face-service/reference
FACE_SERVICE_URL=http://localhost:5000
# Demo registration can enrol a reference face. Keep 0 outside a controlled prototype.
ALLOW_ENROLL=1
